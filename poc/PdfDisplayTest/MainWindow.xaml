<Window x:Class="PdfDisplayTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF表示テスト"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Width="120"
                Height="32"
                HorizontalAlignment="Left"
                Content="PDFを開く"
                Click="OpenPdfButton_Click" />

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Background="#666666"
                BorderBrush="#444444"
                BorderThickness="1">

            <Image x:Name="PdfImage"
                Stretch="Uniform"
                Margin="8" />
                
        </Border>

        <TextBlock x:Name="FilePathText"
                   Grid.Row="2"
                   Text="PDFが選択されていません"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>