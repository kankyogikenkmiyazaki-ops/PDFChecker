<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Ver1.51 リリース情報 -->
    <Version>1.51.0</Version>
    <AssemblyVersion>1.51.0.0</AssemblyVersion>
    <FileVersion>1.51.0.0</FileVersion>
    <Product>PDFMarkup</Product>

    <!-- Windows 実行ファイルのアプリアイコン -->
    <ApplicationIcon>Assets\PDFMarkup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFium.WindowsV2" Version="1.1.4" />
    <PackageReference Include="PDFiumSharpV2" Version="1.1.4" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
