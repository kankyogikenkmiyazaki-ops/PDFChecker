<Window x:Class="PDFMarkup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Markup"
        Width="1400"
        Height="850"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 朱書き／チェックのモード切替ボタン -->
        <Style x:Key="ModeRadioButtonStyle"
               TargetType="RadioButton">

            <Setter Property="Foreground"
                    Value="#222222" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="ModeButtonBorder"
                                Background="#F4F4F4"
                                BorderBrush="#AAAAAA"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ModeButtonBorder"
                                        Property="Background"
                                        Value="#E5E5E5" />

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="ModeButtonBorder"
                                        Property="Background"
                                        Value="#FFFFFF" />

                                <Setter TargetName="ModeButtonBorder"
                                        Property="BorderBrush"
                                        Value="#555555" />

                                <Setter TargetName="ModeButtonBorder"
                                        Property="BorderThickness"
                                        Value="2" />

                                <Setter Property="FontWeight"
                                        Value="Bold" />

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ModeButtonBorder"
                                        Property="Opacity"
                                        Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ツールバー内の通常ボタン -->
        <Style x:Key="ToolBarButtonStyle"
               TargetType="Button">

            <Setter Property="MinWidth"
                    Value="38" />

            <Setter Property="Height"
                    Value="30" />

            <Setter Property="Margin"
                    Value="2,1" />

            <Setter Property="Padding"
                    Value="7,3" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />

        </Style>

        <!-- 右側パネル内の見出し -->
        <Style x:Key="SidePanelSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Margin"
                    Value="0,0,0,8" />

        </Style>

        <!-- 色パレット用ボタン -->
        <Style x:Key="ColorPaletteButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="28" />

            <Setter Property="Height"
                    Value="28" />

            <Setter Property="Margin"
                    Value="3" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="BorderBrush"
                    Value="#777777" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>

        <!-- 現在選択中の色ボタン。黒い外枠と白い内枠で色に依存せず識別する。 -->
        <Style x:Key="SelectedColorPaletteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ColorPaletteButtonStyle}">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#222222"
                                Padding="2"
                                CornerRadius="1">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="White"
                                    BorderThickness="1" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4"
                                      ShadowDepth="1"
                                      Opacity="0.45" />
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- 上部メニュー -->
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="ファイル">

                <MenuItem Header="PDFを開く"
                          Click="OpenPdfMenuItem_Click" />

                <Separator />

                <MenuItem Header="保存" />

                <MenuItem Header="名前を付けて保存"
                          Click="SaveAsMenuItem_Click" />

                <Separator />

                <MenuItem Header="終了" />

            </MenuItem>

            <MenuItem Header="編集">

                <MenuItem Header="元に戻す"
                          InputGestureText="Ctrl+Z"
                          Click="UndoMenuItem_Click" />

                <MenuItem Header="やり直す"
                          InputGestureText="Ctrl+Y"
                          Click="RedoMenuItem_Click" />

            </MenuItem>

            <MenuItem Header="表示">

                <MenuItem Header="拡大" />
                <MenuItem Header="縮小" />
                <MenuItem Header="全体表示" />

            </MenuItem>

        </Menu>

        <!-- 上部ツールバー -->
        <Border x:Name="MainToolBarBorder"
                DockPanel.Dock="Top"
                Background="#FCE8E8"
                BorderBrush="#BBBBBB"
                BorderThickness="0,0,0,1">

            <ToolBarTray Background="Transparent"
                         IsLocked="True">

                <ToolBar x:Name="MainToolBar"
                         Background="Transparent"
                         Band="0"
                         BandIndex="0">

                    <!-- ファイル操作 -->
                    <Button x:Name="OpenPdfButton"
                            Content="開く"
                            ToolTip="PDFを開く"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="OpenPdfMenuItem_Click" />

                    <Button x:Name="SavePdfButton"
                            Content="保存"
                            ToolTip="現在のPDFを保存"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="SaveMenuItem_Click" />

                    <Button x:Name="SaveAsPdfButton"
                            Content="別名保存"
                            ToolTip="名前を付けて保存"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="SaveAsMenuItem_Click" />

                    <Separator />

                    <!-- 描画モード -->
                    <Button x:Name="MarkupModeButton"
                            Content="朱書き"
                            ToolTip="朱書き描画へ切り替える"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Padding="12,5"
                            Margin="2,2,0,2"
                            Click="MarkupModeButton_Click" />

                    <Button x:Name="MarkupVisibilityButton"
                            Content="👁"
                            ToolTip="朱書きを非表示にする"
                            Style="{StaticResource ToolBarButtonStyle}"
                            FontSize="15"
                            Width="30"
                            Padding="2"
                            Margin="0,2,5,2"
                            Click="MarkupVisibilityButton_Click" />

                    <Button x:Name="CheckModeButton"
                            Content="チェック"
                            ToolTip="チェック描画へ切り替える"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Padding="12,5"
                            Margin="2,2,0,2"
                            Click="CheckModeButton_Click" />

                    <Button x:Name="CheckVisibilityButton"
                            Content="👁"
                            ToolTip="チェックを非表示にする"
                            Style="{StaticResource ToolBarButtonStyle}"
                            FontSize="15"
                            Width="30"
                            Padding="2"
                            Margin="0,2,5,2"
                            Click="CheckVisibilityButton_Click" />

                    <Separator />

                    <!-- 描画操作 -->
                    <Button x:Name="TextToolButton"
                            Content="A"
                            ToolTip="テキスト入力モード"
                            Style="{StaticResource ToolBarButtonStyle}"
                            FontWeight="Bold"
                            Click="TextToolButton_Click" />

                    <ComboBox x:Name="TextFontSizeComboBox"
                              Width="40"
                              Height="28"
                              Margin="4,0,4,0"
                              VerticalAlignment="Center"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              SelectedIndex="4"
                              ToolTip="文字サイズ（pt）"
                              SelectionChanged="TextFontSizeComboBox_SelectionChanged"
                              LostKeyboardFocus="TextFontSizeComboBox_LostKeyboardFocus"
                              PreviewKeyDown="TextFontSizeComboBox_PreviewKeyDown">
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="32" />
                        <ComboBoxItem Content="40" />
                    </ComboBox>

                    <TextBlock Text="pt"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />

                    <Button x:Name="SelectToolButton"
                            Content="選択"
                            ToolTip="注釈選択モード"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="SelectToolButton_Click" />

                    <Button x:Name="EraserButton"
                            Content="消しゴム"
                            ToolTip="消しゴムモードに切り替える"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="EraserButton_Click" />

                    <Button x:Name="HandToolButton"
                            Content="手"
                            ToolTip="手のひらツール"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="HandToolButton_Click" />

                    <Separator />

                    <!-- Undo / Redo -->
                    <Button x:Name="UndoButton"
                            Content="↶"
                            ToolTip="元に戻す Ctrl+Z"
                            FontSize="18"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="UndoMenuItem_Click" />

                    <Button x:Name="RedoButton"
                            Content="↷"
                            ToolTip="やり直す Ctrl+Y"
                            FontSize="18"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="RedoMenuItem_Click" />

                    <Separator />

                    <!-- ページ移動 -->
                    <Button x:Name="PreviousPageButton"
                            Content="◀"
                            ToolTip="前のページ Ctrl+←"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="PreviousPageButton_Click"
                            IsEnabled="False" />

                    <TextBlock x:Name="PageNavigationText"
                               Text="- / -"
                               MinWidth="55"
                               Margin="6,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />

                    <Button x:Name="NextPageButton"
                            Content="▶"
                            ToolTip="次のページ Ctrl+→"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="NextPageButton_Click"
                            IsEnabled="False" />

                    <Separator />

                    <!-- 表示操作 -->
                    <Button x:Name="ZoomOutButton"
                            Content="－"
                            ToolTip="縮小"
                            FontSize="18"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="ZoomOutButton_Click" />

                    <Button x:Name="ZoomInButton"
                            Content="＋"
                            ToolTip="拡大"
                            FontSize="18"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="ZoomInButton_Click" />

                    <Button x:Name="FitPageButton"
                            Content="全体"
                            ToolTip="PDF全体を表示"
                            Style="{StaticResource ToolBarButtonStyle}"
                            Click="FitPageButton_Click" />

                </ToolBar>

            </ToolBarTray>

        </Border>

        <!-- 下部ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="PDFを開いてください" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem>
                <TextBlock x:Name="PageText"
                           Text="ページ: -" />
            </StatusBarItem>

            <Separator />

            <StatusBarItem>
                <TextBlock x:Name="ZoomText"
                           Text="倍率: 100%" />
            </StatusBarItem>

        </StatusBar>

        <!-- メイン画面 -->
        <Grid>

            <Grid.ColumnDefinitions>

                <!-- 左側ページ一覧 -->
                <ColumnDefinition x:Name="LeftPanelColumn"
                                  Width="220"
                                  MinWidth="220" />

                <!-- 左パネル幅変更用 -->
                <ColumnDefinition Width="5" />

                <!-- 左パネル開閉ボタン -->
                <ColumnDefinition Width="24" />

                <!-- PDF表示 -->
                <ColumnDefinition Width="*" />

                <!-- 右パネル開閉ボタン -->
                <ColumnDefinition Width="24" />

                <!-- 右パネル幅変更用 -->
                <ColumnDefinition Width="5" />

                <!-- 右側設定パネル -->
                <ColumnDefinition x:Name="RightPanelColumn"
                                  Width="260"
                                  MinWidth="260" />

            </Grid.ColumnDefinitions>

            <!-- 左側ページ一覧 -->
            <Border Grid.Column="0"
                    Background="#F3F3F3"
                    BorderBrush="#CCCCCC"
                    BorderThickness="0,0,1,0">

                <DockPanel>

                    <Border DockPanel.Dock="Top"
                            Background="#E5E5E5"
                            Padding="10">

                        <TextBlock Text="ページ一覧"
                                   FontWeight="Bold" />

                    </Border>

                    <Grid>

                        <TextBlock x:Name="PageListEmptyText"
                                   Text="PDFを開くとページが表示されます"
                                   Margin="12"
                                   Foreground="#777777"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top" />

                        <ListBox x:Name="PageListBox"
                                 Margin="6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="PageListBox_SelectionChanged">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />

                                    <Setter Property="Margin"
                                            Value="3,4" />

                                    <Setter Property="Padding"
                                            Value="4" />

                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Setter Property="BorderBrush"
                                            Value="Transparent" />

                                    <Setter Property="BorderThickness"
                                            Value="2" />

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">

                                                <Border x:Name="ThumbnailItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3"
                                                        Padding="{TemplateBinding Padding}">

                                                    <ContentPresenter />

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbnailItemBorder"
                                                                Property="Background"
                                                                Value="#E9F2FC" />

                                                    </Trigger>

                                                    <Trigger Property="IsSelected"
                                                             Value="True">

                                                        <Setter TargetName="ThumbnailItemBorder"
                                                                Property="Background"
                                                                Value="#DCEEFF" />

                                                        <Setter TargetName="ThumbnailItemBorder"
                                                                Property="BorderBrush"
                                                                Value="#1976D2" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel HorizontalAlignment="Center">

                                        <Border Width="170"
                                                MinHeight="80"
                                                Background="White"
                                                BorderBrush="#AFAFAF"
                                                BorderThickness="1"
                                                Padding="3">

                                            <Grid>

                                                <TextBlock Text="読込中..."
                                                           Foreground="#888888"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>

                                                </TextBlock>

                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                            </Grid>

                                        </Border>

                                        <TextBlock Text="{Binding PageNumber}"
                                                   Margin="0,5,0,1"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333" />

                                    </StackPanel>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </DockPanel>

            </Border>

            <!-- 左側ページ一覧の幅変更用 -->
            <GridSplitter x:Name="LeftPanelSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#B8B8B8"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <!-- 左側ページ一覧の開閉レール -->
            <Button x:Name="ToggleLeftPanelButton"
                    Grid.Column="2"
                    Content="◀"
                    ToolTip="ページ一覧を閉じる"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#D0D0D0"
                    BorderBrush="#B8B8B8"
                    BorderThickness="0"
                    Click="ToggleLeftPanelButton_Click" />

            <!-- PDF表示領域 -->
            <Border Grid.Column="3"
                    Background="#666666">

                <Grid>

                <ScrollViewer x:Name="PdfViewport"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="None"
                              IsManipulationEnabled="False"
                              SizeChanged="PdfViewport_SizeChanged"
                              PreviewMouseDown="PdfViewport_PreviewMouseDown"
                              PreviewMouseMove="PdfViewport_PreviewMouseMove"
                              PreviewMouseUp="PdfViewport_PreviewMouseUp"
                              PreviewMouseWheel="PdfViewport_PreviewMouseWheel">

                    <!-- 余白を含めたPDF配置領域 -->
                    <Grid x:Name="PdfScrollContent"
                          MinWidth="{Binding ActualWidth, ElementName=PdfViewport}"
                          MinHeight="{Binding ActualHeight, ElementName=PdfViewport}">

                        <!-- PDFページ本体 -->
                        <Grid x:Name="PdfPageHost"
                              Width="600"
                              Height="700"
                              Margin="30"
                              Background="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ClipToBounds="True">

                            <!-- PDFページ画像 -->
                            <Image x:Name="PdfImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />

                            <!-- PDF上の描画レイヤー -->
                            <Canvas x:Name="DrawingCanvas"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                                    MouseMove="DrawingCanvas_MouseMove"
                                    MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp" />

                            <!-- PDFページ外枠 -->
                            <Border BorderBrush="#444444"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />

                        </Grid>

                    </Grid>

                </ScrollViewer>

                <!-- PDF未選択時に表示する最近使ったファイル一覧 -->
                <Border x:Name="StartPanel"
                        Background="#F3F3F3"
                        Padding="36"
                        Visibility="Visible">

                    <Grid MaxWidth="760"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="PDF Markup"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1"
                                   Text="最近使ったPDF"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#444444"
                                   Margin="0,12,0,10" />

                        <StackPanel Grid.Row="2">

                            <TextBlock x:Name="RecentFilesEmptyText"
                                       Text="最近使ったPDFはありません。"
                                       Foreground="#777777"
                                       Margin="4,4,0,12" />

                            <ItemsControl x:Name="RecentFilesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding FullPath}"
                                                Click="RecentFileButton_Click"
                                                Margin="0,0,0,7"
                                                Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                Background="White"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"
                                                Cursor="Hand">

                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222222"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding DirectoryPath}"
                                                           FontSize="11"
                                                           Foreground="#777777"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <Button Grid.Row="3"
                                Content="PDFを開く..."
                                Width="130"
                                Height="34"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="OpenPdfMenuItem_Click" />

                    </Grid>

                </Border>

                </Grid>

            </Border>

            <!-- 右側設定パネルの開閉レール -->
            <Button x:Name="ToggleRightPanelButton"
                    Grid.Column="4"
                    Content="▶"
                    ToolTip="設定パネルを閉じる"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#D0D0D0"
                    BorderBrush="#B8B8B8"
                    BorderThickness="0"
                    Click="ToggleRightPanelButton_Click" />

            <!-- 右側設定パネルの幅変更用 -->
            <Thumb x:Name="RightPanelSplitter"
                   Grid.Column="5"
                   Width="5"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Background="#B8B8B8"
                   Cursor="SizeWE"
                   DragDelta="RightPanelSplitter_DragDelta" />

            <!-- 右側設定パネル -->
            <Border Grid.Column="6"
                    Background="#F7F7F7"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- 描画設定 -->
                        <Border x:Name="DrawingSettingsHeaderBorder"
                                Background="#FCE8E8"
                                Padding="10">

                            <TextBlock Text="描画設定"
                                       FontWeight="Bold" />

                        </Border>

                        <StackPanel Margin="12">

                            <TextBlock Text="現在のモード"
                                       Style="{StaticResource SidePanelSectionTitleStyle}" />

                            <TextBlock x:Name="CurrentDrawingModeText"
                                       Text="朱書き"
                                       Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,8">

                                <TextBlock Text="色"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                <!-- 口径変更時の色連動設定。今回は表示のみ追加する。 -->
                                <CheckBox x:Name="AutoColorChangeCheckBox"
                                          Content="自動変更"
                                          IsChecked="True"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Click="AutoColorChangeCheckBox_Click" />

                            </Grid>

                            <!-- 朱書き用3色 -->
                            <WrapPanel x:Name="MarkupColorPalette"
                                       Margin="0,0,0,14">

                                <Button ToolTip="赤"
                                        Tag="Red"
                                        Style="{StaticResource ColorPaletteButtonStyle}"
                                        Background="#E53935"
                                        Click="StrokeColorButton_Click" />

                                <Button ToolTip="青"
                                        Tag="Blue"
                                        Style="{StaticResource ColorPaletteButtonStyle}"
                                        Background="#1E88E5"
                                        Click="StrokeColorButton_Click" />

                                <Button ToolTip="緑"
                                        Tag="Green"
                                        Style="{StaticResource ColorPaletteButtonStyle}"
                                        Background="#43A047"
                                        Click="StrokeColorButton_Click" />

                            </WrapPanel>

                            <!-- チェック用10色 -->
                            <WrapPanel x:Name="CheckColorPalette"
                                       Margin="0,0,0,14"
                                       Visibility="Collapsed">

                                <Button ToolTip="黄" Tag="Yellow" Style="{StaticResource ColorPaletteButtonStyle}" Background="#FDD835" Click="StrokeColorButton_Click" />
                                <Button ToolTip="橙" Tag="Orange" Style="{StaticResource ColorPaletteButtonStyle}" Background="#FB8C00" Click="StrokeColorButton_Click" />
                                <Button ToolTip="桃" Tag="Pink" Style="{StaticResource ColorPaletteButtonStyle}" Background="#EC407A" Click="StrokeColorButton_Click" />
                                <Button ToolTip="水色" Tag="LightBlue" Style="{StaticResource ColorPaletteButtonStyle}" Background="#42A5F5" Click="StrokeColorButton_Click" />
                                <Button ToolTip="黄緑" Tag="LightGreen" Style="{StaticResource ColorPaletteButtonStyle}" Background="#9CCC65" Click="StrokeColorButton_Click" />
                                <Button ToolTip="紫" Tag="Purple" Style="{StaticResource ColorPaletteButtonStyle}" Background="#8E24AA" Click="StrokeColorButton_Click" />
                                <Button ToolTip="茶" Tag="Brown" Style="{StaticResource ColorPaletteButtonStyle}" Background="#6D4C41" Click="StrokeColorButton_Click" />
                                <Button ToolTip="灰" Tag="Gray" Style="{StaticResource ColorPaletteButtonStyle}" Background="#757575" Click="StrokeColorButton_Click" />
                                <Button ToolTip="シアン" Tag="Cyan" Style="{StaticResource ColorPaletteButtonStyle}" Background="#00ACC1" Click="StrokeColorButton_Click" />
                                <Button ToolTip="マゼンタ" Tag="Magenta" Style="{StaticResource ColorPaletteButtonStyle}" Background="#D81B60" Click="StrokeColorButton_Click" />

                            </WrapPanel>

                            <Grid Margin="0,0,0,8">

                                <TextBlock Text="太さ"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                <!-- 現在の色と太さを実線で表示する。 -->
                                <Line x:Name="StrokeThicknessPreviewLine"
                                      X1="0"
                                      Y1="0"
                                      X2="54"
                                      Y2="0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Stroke="#E53935"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />

                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,14">

                                <Slider x:Name="StrokeThicknessSlider"
                                        Minimum="1"
                                        Maximum="20"
                                        Value="3"
                                        Width="150"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="StrokeThicknessSlider_ValueChanged" />

                                <TextBlock x:Name="StrokeThicknessText"
                                           Text="3.0"
                                           Width="45"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />

                            </StackPanel>

                            <Grid Margin="0,0,0,8">

                                <TextBlock Text="透明度"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                <!-- 現在の色を、実際の透明度に近い見え方で表示する。 -->
                                <Border Width="54"
                                        Height="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        BorderBrush="#999999"
                                        BorderThickness="1"
                                        Background="#F4F4F4">

                                    <Border x:Name="StrokeOpacityPreviewBorder"
                                            Background="#E53935"
                                            Opacity="1" />

                                </Border>

                            </Grid>

                            <StackPanel Orientation="Horizontal">

                                <Slider x:Name="StrokeOpacitySlider"
                                        Minimum="10"
                                        Maximum="100"
                                        Value="90"
                                        Width="150"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="StrokeOpacitySlider_ValueChanged" />

                                <TextBlock x:Name="StrokeOpacityText"
                                           Text="90%"
                                           Width="45"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" />

                            </StackPanel>

                        </StackPanel>

                        <Separator Margin="10,4" />

                        <!-- 注釈情報 -->
                        <Border x:Name="AnnotationInfoHeaderBorder"
                                Background="#FCE8E8"
                                Padding="10">

                            <TextBlock Text="注釈情報"
                                       FontWeight="Bold" />

                        </Border>

                        <StackPanel Margin="12">

                            <TextBlock Text="口径"
                                       Style="{StaticResource SidePanelSectionTitleStyle}" />

                            <ComboBox x:Name="DiameterComboBox"
                                      SelectedIndex="0"
                                      Margin="0,0,0,14"
                                      SelectionChanged="DiameterComboBox_SelectionChanged">

                                <ComboBoxItem Content="未設定" />
                                <ComboBoxItem Content="φ50" />
                                <ComboBoxItem Content="φ75" />
                                <ComboBoxItem Content="φ100" />
                                <ComboBoxItem Content="φ150" />
                                <ComboBoxItem Content="φ200" />
                                <ComboBoxItem Content="φ300" />
                                <ComboBoxItem Content="φ400" />

                            </ComboBox>

                            <TextBlock Text="コメント"
                                       Style="{StaticResource SidePanelSectionTitleStyle}" />

                                <TextBox x:Name="AnnotationCommentTextBox"
                                        Height="90"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        TextChanged="AnnotationCommentTextBox_TextChanged"
                                        GotKeyboardFocus="AnnotationCommentTextBox_GotKeyboardFocus"
                                        LostKeyboardFocus="AnnotationCommentTextBox_LostKeyboardFocus"
                                        PreviewKeyDown="AnnotationCommentTextBox_PreviewKeyDown" />



                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </DockPanel>

</Window>
